[Unit]
Description=Auto Trading Bot - Limit Orders at S/R Levels
After=network.target

[Service]
Type=simple
User=fedricintandamai
WorkingDirectory=/home/fedricintandamai/auto-trading-bot
ExecStart=/home/fedricintandamai/auto-trading-bot/venv/bin/python3 /home/fedricintandamai/auto-trading-bot/main.py
Restart=always
RestartSec=10
EnvironmentFile=/home/fedricintandamai/auto-trading-bot/.env

[Install]
WantedBy=multi-user.target
