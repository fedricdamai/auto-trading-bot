[Unit]
Description=Auto Trading Bot - Support & Resistance Levels
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ClaudeVibeCode
ExecStart=/usr/bin/python3 /home/ubuntu/ClaudeVibeCode/main.py
Restart=always
RestartSec=10
EnvironmentFile=/home/ubuntu/ClaudeVibeCode/.env

[Install]
WantedBy=multi-user.target
