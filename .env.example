# ============================================================
# Exchange Backend: "hyperliquid" or "ccxt"
# ============================================================
EXCHANGE_BACKEND=hyperliquid

# --- Hyperliquid settings ---
HL_WALLET_ADDRESS=0xYourWalletAddress
HL_PRIVATE_KEY=your_private_key_here
HL_SYMBOL=BTC
HL_LEVERAGE=3
HL_MAX_LEVERAGE=5
HL_MAINNET=false

# --- ccxt settings (only if EXCHANGE_BACKEND=ccxt) ---
EXCHANGE_ID=binance
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
SYMBOL=BTC/USDT

# ============================================================
# Trading settings
# ============================================================
TIMEFRAME=5m
LOOKBACK_CANDLES=200
MIN_TOUCHES=2
LEVEL_TOLERANCE_PCT=0.5
ORDER_SIZE=50
# Target profit % on margin per trade (1.0 = earn 1% per trade)
TARGET_PNL_PCT=1.0
# Max loss % on margin per trade (auto-capped above liquidation)
MAX_LOSS_PCT=1.0
# How often to poll price (seconds) — 5 = every 5 seconds
CHECK_INTERVAL=5
PAPER_TRADE=false
LOG_LEVEL=INFO

# ============================================================
# Scalp trading settings
# ============================================================
# Max simultaneous positions (scalp mode = 1)
MAX_OPEN_ORDERS=1
# Cancel unfilled orders after this many hours
ORDER_TTL_HOURS=24
# Re-detect S/R levels every N seconds (300 = 5 minutes)
LEVEL_REFRESH_SECONDS=300
# Price within this % of a level = TOUCH → enter position
TOUCH_PCT=0.1
# Price within this % of a level = APPROACHING → prepare
APPROACH_PCT=0.3
# Check for doji candles every N seconds
DOJI_CHECK_SECONDS=300
# Wait N seconds after closing before opening a new position
COOLDOWN_SECONDS=60

# ============================================================
# Telegram notifications (optional)
# Create a bot via @BotFather, get chat ID via @userinfobot
# ============================================================
TG_BOT_TOKEN=
TG_CHAT_ID=
# Comma-separated Telegram user IDs allowed to use commands
# If empty, defaults to TG_CHAT_ID owner only
TG_ALLOWED_USERS=
