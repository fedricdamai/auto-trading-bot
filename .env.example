# ============================================================
# Runtime / deployment only
# Trading parameters live in bot/strategy_settings.py
# ============================================================
EXCHANGE_BACKEND=hyperliquid
TRADER_VERSION=v2

# Safe default while validating. No real orders are submitted in paper mode.
PAPER_TRADE=true
LOG_LEVEL=INFO

# ============================================================
# Hyperliquid credentials + network
# ============================================================
HL_WALLET_ADDRESS=0xYourWalletAddress
HL_PRIVATE_KEY=your_private_key_here

# false = Hyperliquid testnet data/API
# true  = Hyperliquid mainnet data/API
# Keep false during isolated validation.
HL_MAINNET=false

# ============================================================
# ccxt credentials / adapter settings (only if used)
# ============================================================
EXCHANGE_ID=binance
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
SYMBOL=BTC/USDT

# ============================================================
# Telegram credentials (optional)
# ============================================================
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_ALLOWED_USERS=
