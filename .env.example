# ============================================================
# Exchange Backend: "hyperliquid" or "ccxt"
# ============================================================
EXCHANGE_BACKEND=hyperliquid

# --- Hyperliquid settings ---
HL_WALLET_ADDRESS=0xYourWalletAddress
HL_PRIVATE_KEY=your_private_key_here
HL_SYMBOL=BTC
HL_LEVERAGE=3
HL_MAX_LEVERAGE=5
# Set to false for testnet, true for mainnet
HL_MAINNET=false

# --- ccxt settings (only if EXCHANGE_BACKEND=ccxt) ---
EXCHANGE_ID=binance
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
SYMBOL=BTC/USDT

# ============================================================
# Trading settings
# ============================================================
TIMEFRAME=5m
LOOKBACK_CANDLES=200
MIN_TOUCHES=2
LEVEL_TOLERANCE_PCT=0.5
# Max position size in USDC per trade (cap — actual size is computed
# from TARGET_PROFIT_USD and the TP distance to the next S/R zone)
ORDER_SIZE=2000
# Target profit in USD per trade — the bot sizes each position so that
# hitting TP yields this dollar amount (capped at ORDER_SIZE)
TARGET_PROFIT_USD=4.0
# Target profit % on margin per trade (used for TP/SL placement math)
TARGET_PNL_PCT=2.5
# Max loss % on margin per trade (auto-capped above liquidation)
MAX_LOSS_PCT=1.0
# How often to poll price (seconds) — 5 = every 5 seconds
CHECK_INTERVAL=5
# Set to true for paper trading (no real orders), false for live
PAPER_TRADE=false
LOG_LEVEL=INFO

# ============================================================
# TP/SL positioning around support/resistance zones
# ============================================================
# Stop loss sits this % beyond the S/R level that justifies the trade
# (below support for longs, above resistance for shorts)
SL_ZONE_BUFFER_PCT=0.25
# Take profit sits this % in front of the next opposing level
TP_ZONE_BUFFER_PCT=0.15
# Skip a nearby level as TP target unless reward/risk is at least this
MIN_RISK_REWARD=1.5
# Only cancel/re-place exchange TP/SL triggers when a price moved >= this %
# (prevents duplicate trigger orders from tiny trailing adjustments)
TP_SL_SYNC_MIN_CHANGE_PCT=0.1

# ============================================================
# Limit order settings
# ============================================================
# Cancel unfilled limit orders after this many hours
ORDER_TTL_HOURS=24
# Re-detect S/R levels every N seconds (300 = 5 minutes)
LEVEL_REFRESH_SECONDS=300
# Check for doji candles every N seconds
DOJI_CHECK_SECONDS=300
# Wait N seconds after closing before placing a new order
COOLDOWN_SECONDS=60

# ============================================================
# Telegram notifications (optional)
# Create a bot via @BotFather, get chat ID via @userinfobot
# ============================================================
TG_BOT_TOKEN=
TG_CHAT_ID=
# Comma-separated Telegram user IDs allowed to use commands
# If empty, defaults to TG_CHAT_ID owner only
TG_ALLOWED_USERS=
