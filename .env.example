# ============================================================
# Exchange Backend: "hyperliquid" or "ccxt"
# ============================================================
EXCHANGE_BACKEND=hyperliquid

# Hyperliquid uses the safer V2 engine by default.
# Set v1 only for deliberate rollback/comparison.
TRADER_VERSION=v2

# --- Hyperliquid settings ---
HL_WALLET_ADDRESS=0xYourWalletAddress
HL_PRIVATE_KEY=your_private_key_here
HL_SYMBOL=BTC
HL_MAINNET=false

# V2 uses fixed low leverage. The legacy min/max range remains as a hard bound.
HL_LEVERAGE_MIN=3
HL_LEVERAGE_MAX=10
V2_LEVERAGE=3

# --- Multi-symbol ---
HL_MULTI_SYMBOL=true
HL_SYMBOLS=BTC,ETH,SOL,HYPE,BNB
HL_SCAN_TOP_N=10
HL_MAX_POSITIONS=5

# --- ccxt settings (only if EXCHANGE_BACKEND=ccxt) ---
EXCHANGE_ID=binance
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
SYMBOL=BTC/USDT

# ============================================================
# General trading settings
# ============================================================
# V2 decisions use 30m/1h/4h. The 5-second loop only manages exchange state.
TIMEFRAME=30m
LOOKBACK_CANDLES=200
MIN_TOUCHES=2
LEVEL_TOLERANCE_PCT=0.5
ORDER_SIZE=2000
CHECK_INTERVAL=5
PAPER_TRADE=true
LOG_LEVEL=INFO

# ============================================================
# Trader V2: higher-timeframe confirmed entries
# ============================================================
# Dollar risk sizing. Position notional is derived from the structural stop.
V2_RISK_PER_TRADE_USD=4
V2_MAX_POSITION_NOTIONAL_USD=500
V2_MIN_POSITION_NOTIONAL_USD=10
# Max isolated margin for one trade as fraction of account value.
V2_MAX_MARGIN_FRACTION=0.10

# 4h + 1h trend agreement and 30m/1h/4h S/R quality gates.
V2_MIN_TREND_CONFIDENCE=70
V2_MIN_LEVEL_STRENGTH=65
V2_MIN_LEVEL_TIMEFRAMES=2
V2_MAX_LEVEL_DISTANCE_PCT=3.0

# A 30m candle must touch/reject the level. Entry is then a pullback limit.
V2_CONFIRMATION_ZONE_PCT=0.35
V2_ENTRY_PULLBACK_ATR=0.15

# Stop sits beyond structure using ATR, not max-loss-percent / leverage.
V2_SL_ATR_MULT=0.75
V2_SL_ZONE_BUFFER_PCT=0.35
V2_MIN_STOP_DISTANCE_PCT=0.60
V2_MAX_STOP_DISTANCE_PCT=2.50

# TP targets a modest R multiple, but a nearer opposing level invalidates trade.
V2_TARGET_RISK_REWARD=1.50
V2_TP_ZONE_BUFFER_PCT=0.15

# No immediate re-entry after a position closes.
V2_SYMBOL_COOLDOWN_MINUTES=30

# ============================================================
# Legacy V1 settings (ignored by V2, kept for rollback)
# ============================================================
TARGET_PROFIT_USD=4
TARGET_PNL_PCT=2.5
MAX_LOSS_PCT=1.5
SL_ZONE_BUFFER_PCT=0.25
TP_ZONE_BUFFER_PCT=0.15
MIN_RISK_REWARD=1.5
TP_SL_SYNC_MIN_CHANGE_PCT=0.1
ORDER_TTL_HOURS=2
LEVEL_REFRESH_SECONDS=300
DOJI_CHECK_SECONDS=300
COOLDOWN_SECONDS=60

# ============================================================
# Telegram notifications (optional)
# ============================================================
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_ALLOWED_USERS=
